---
interface Props {
  profile: {
    name: string;
    avatarText: string;
    avatarUrl: string;
    bio: string;
    interests: string[];
    links: { label: string; url: string }[];
  };
}
const { profile } = Astro.props;
---

<div class="avatar-anchor" data-avatar>
  <button class="avatar" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="avatar-pop" data-avatar-btn>
    {profile.avatarUrl ? <img src={profile.avatarUrl} alt="" width="36" height="36" /> : <span aria-hidden="true">{profile.avatarText || profile.name.slice(0, 1)}</span>}
    <span class="sr-only">关于 {profile.name}</span>
  </button>
  <div class="avatar-pop" id="avatar-pop" role="dialog" aria-label={`关于 ${profile.name}`}>
    <div class="pop-name">{profile.name}</div>
    {profile.bio && <p class="pop-bio">{profile.bio}</p>}
    {
      profile.interests.length > 0 && (
        <div class="pop-tags">
          {profile.interests.map((t) => (
            <span class="pill">{t}</span>
          ))}
        </div>
      )
    }
    {
      profile.links.length > 0 && (
        <div class="pop-links">
          {profile.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener noreferrer me">
              {l.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .avatar-anchor { position: relative; display: flex; align-items: center; }
  .avatar {
    width: 36px; height: 36px; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line)); border-radius: 50%;
    background: var(--tint); font: italic 17px Georgia, var(--serif); color: var(--accent); display: grid; place-items: center;
    padding: 0; overflow: hidden; transition: transform calc(0.35s * var(--dur)) var(--ease);
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-anchor:hover .avatar { transform: rotate(-8deg); }
  .avatar-pop {
    position: absolute; top: 48px; right: -6px; width: 290px; padding: 20px 22px; border: 1px solid var(--line);
    background: var(--surface); box-shadow: var(--shadow); border-radius: 6px; opacity: 0; visibility: hidden;
    transform: translateY(-6px); transition: opacity calc(0.22s * var(--dur)) var(--ease), transform calc(0.22s * var(--dur)) var(--ease), visibility 0s linear calc(0.22s * var(--dur));
    z-index: 70;
  }
  .avatar-anchor:focus-within .avatar-pop, .avatar-anchor[data-open] .avatar-pop {
    opacity: 1; visibility: visible; transform: none; transition-delay: 0s;
  }
  @media (hover: hover) {
    .avatar-anchor:hover .avatar-pop { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  }
  .pop-name { font: 600 17px var(--serif); }
  .pop-bio { margin: 8px 0 12px; color: var(--muted); font-size: 13px; line-height: 1.85; }
  .pop-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .pop-links { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--accent); padding-top: 10px; border-top: 1px solid var(--line); }
  .pop-links a:hover { text-decoration: underline; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-avatar]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-avatar-btn]')!;
    btn.addEventListener('click', () => {
      const open = !('open' in root.dataset);
      if (open) root.dataset.open = '';
      else delete root.dataset.open;
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) { delete root.dataset.open; btn.setAttribute('aria-expanded', 'false'); }
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { delete root.dataset.open; btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
  });
</script>

---
import { listQuotes } from '../../server/services/config';
import type { Settings } from '../../server/seed';

interface Props {
  config: Settings['encourage'];
  easter: Settings['easter'];
  isArticle?: boolean;
  is404?: boolean;
}
const { config, easter, isArticle = false, is404 = false } = Astro.props;
const quotes = config.enabled
  ? listQuotes({ enabledOnly: true }).map((q) => ({ text: q.text, author: q.author, source: q.source, followUp: q.followUp }))
  : [];
const payload = JSON.stringify({ config, easter, isArticle, is404, quotes }).replace(/</g, '\\u003c');
---

<script type="application/json" id="fn-ambient" set:html={payload} />

<script>
  import { initialState, roll, type EncourageConfig, type EncourageState } from '../../lib/encourage';

  type Payload = {
    config: EncourageConfig & { enabled: boolean; durationSeconds: number; quietOnArticle: boolean; animation: 'rise' | 'fade' };
    easter: { enabled: boolean; set: string; triggers: Record<string, boolean> };
    isArticle: boolean;
    is404: boolean;
    quotes: { text: string; author: string; source: string; followUp: string }[];
  };

  const el = document.getElementById('fn-ambient');
  const data: Payload | null = el ? JSON.parse(el.textContent || 'null') : null;
  const KEY = 'fn-encourage';

  if (data?.config.enabled && data.quotes.length) {
    const cfg = data.config;
    // Reading an article: halve the chance per roll so long reads aren't interrupted.
    const effective = cfg.quietOnArticle && data.isArticle
      ? { ...cfg, baseChance: cfg.baseChance / 2, increment: cfg.increment / 2, maxChance: cfg.maxChance / 2 }
      : cfg;
    const load = (): EncourageState => {
      try { return { ...initialState(effective), ...JSON.parse(sessionStorage.getItem(KEY) || '{}') }; }
      catch { return initialState(effective); }
    };
    const typing = () => {
      const a = document.activeElement;
      return !!a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || (a as HTMLElement).isContentEditable);
    };
    setInterval(() => {
      if (document.hidden || typing() || document.querySelector('.enc-card')) return;
      const r = roll(effective, load(), Date.now());
      sessionStorage.setItem(KEY, JSON.stringify(r.state));
      if (r.show) {
        const q = data.quotes[Math.floor(Math.random() * data.quotes.length)]!;
        void import('../../lib/ambient-ui').then((m) => m.showEncouragement(q, cfg.durationSeconds, cfg.animation));
      }
    }, Math.max(1, cfg.intervalMinutes) * 60_000);
  }

  if (data?.easter.enabled) {
    void import('../../lib/eggs').then((m) => m.startEggs(data.easter, { isArticle: data.isArticle, is404: data.is404 }));
  }
</script>

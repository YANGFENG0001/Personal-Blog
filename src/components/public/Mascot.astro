---
/**
 * Corner mascot: one of the built-in original characters or an image the
 * owner uploaded. Clicking shows a short line; it can be dragged anywhere on
 * screen (pointer or Alt+arrow keys), and the spot is remembered per browser.
 * Double-click returns it to its corner. Hidden on small screens and in print.
 */
import { mascotSvg } from '../../lib/mascot';
import '../../styles/mascot.css';

interface Props {
  character: 'haru' | 'sora' | 'chibi';
  draggable: boolean;
  imageUrl: string;
  position: 'right' | 'left';
  size: 'sm' | 'md' | 'lg';
}
const { character, draggable, imageUrl, position, size } = Astro.props;
const kind = imageUrl ? 'image' : character === 'chibi' ? 'chibi' : 'anime';
---

<div class="mascot" data-pos={position} data-size={size} data-kind={kind} data-character={character} data-mascot data-draggable={draggable ? '' : undefined}>
  <span class="mascot-bubble" data-mascot-bubble role="status" aria-live="polite"></span>
  <button
    type="button"
    class="mascot-btn"
    aria-label={draggable ? '看板娘：点击打招呼，拖动可移动位置，双击回到角落' : '看板娘（点击打招呼）'}
    data-mascot-btn
  >
    {imageUrl ? <img src={imageUrl} alt="" loading="lazy" decoding="async" draggable="false" /> : <Fragment set:html={mascotSvg(character)} />}
  </button>
  <button type="button" class="mascot-hide" aria-label="暂时隐藏看板娘" data-mascot-hide>×</button>
</div>

<script>
  import { MASCOT_LINES, isMascotId } from '../../lib/mascot';
  const root = document.querySelector<HTMLElement>('[data-mascot]');
  if (root) {
    if (sessionStorage.getItem('fn-mascot-hidden')) root.hidden = true;
    const btn = root.querySelector<HTMLElement>('[data-mascot-btn]')!;
    const bubble = root.querySelector<HTMLElement>('[data-mascot-bubble]')!;
    const id = root.dataset.character ?? 'haru';
    const lines = MASCOT_LINES[isMascotId(id) ? id : 'haru'];
    const KEY = 'fn-mascot-pos';
    let timer = 0;
    let i = Math.floor(Math.random() * lines.length);

    const say = (text?: string) => {
      if (!text) { i = (i + 1) % lines.length; text = lines[i]!; }
      bubble.textContent = text;
      root.classList.remove('is-talking');
      void root.offsetWidth;
      root.classList.add('is-talking');
      clearTimeout(timer);
      timer = window.setTimeout(() => root.classList.remove('is-talking'), 3400);
    };

    /* ---- position: stored as fractions of the viewport so it survives resizes ---- */
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const place = (x: number, y: number) => {
      const w = root.offsetWidth;
      const h = root.offsetHeight;
      const px = clamp(x, 0, innerWidth - w);
      const py = clamp(y, 0, innerHeight - h);
      root.style.left = `${px}px`;
      root.style.top = `${py}px`;
      root.style.right = 'auto';
      root.style.bottom = 'auto';
      root.classList.add('is-free');
      // Keep the bubble on the roomier side.
      root.dataset.bubble = px + w / 2 > innerWidth / 2 ? 'left' : 'right';
      return [px, py] as const;
    };
    const save = (x: number, y: number) => localStorage.setItem(KEY, JSON.stringify({ fx: x / innerWidth, fy: y / innerHeight }));
    const reset = () => {
      localStorage.removeItem(KEY);
      root.classList.remove('is-free');
      root.style.left = root.style.top = root.style.right = root.style.bottom = '';
      delete root.dataset.bubble;
    };
    const restore = () => {
      try {
        const p = JSON.parse(localStorage.getItem(KEY) ?? 'null') as { fx: number; fy: number } | null;
        if (p && Number.isFinite(p.fx) && Number.isFinite(p.fy)) place(p.fx * innerWidth, p.fy * innerHeight);
      } catch { /* ignore */ }
    };

    const draggable = root.hasAttribute('data-draggable');
    if (draggable) {
      requestAnimationFrame(restore);
      addEventListener('resize', () => { if (root.classList.contains('is-free')) restore(); });

      let start: { x: number; y: number; left: number; top: number; id: number } | null = null;
      let moved = false;
      btn.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        const r = root.getBoundingClientRect();
        start = { x: e.clientX, y: e.clientY, left: r.left, top: r.top, id: e.pointerId };
        moved = false;
      });
      btn.addEventListener('pointermove', (e) => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x;
        const dy = e.clientY - start.y;
        if (!moved && Math.hypot(dx, dy) < 5) return;
        if (!moved) {
          moved = true;
          btn.setPointerCapture(e.pointerId);
          root.classList.add('is-dragging');
          say('哇——');
        }
        place(start.left + dx, start.top + dy);
      });
      const end = (e: PointerEvent) => {
        if (!start || e.pointerId !== start.id) return;
        if (moved) {
          root.classList.remove('is-dragging');
          const r = root.getBoundingClientRect();
          save(r.left, r.top);
          say(lines[lines.length - 1]);
        }
        start = null;
      };
      btn.addEventListener('pointerup', end);
      btn.addEventListener('pointercancel', end);
      // A drag must not also count as a click.
      btn.addEventListener('click', (e) => { if (moved) { e.stopImmediatePropagation(); moved = false; } }, true);
      btn.addEventListener('dblclick', () => { reset(); say('回到老位置啦。'); });
      btn.addEventListener('keydown', (e) => {
        if (!e.altKey || !e.key.startsWith('Arrow')) return;
        e.preventDefault();
        const r = root.getBoundingClientRect();
        const step = e.shiftKey ? 60 : 20;
        const dx = e.key === 'ArrowLeft' ? -step : e.key === 'ArrowRight' ? step : 0;
        const dy = e.key === 'ArrowUp' ? -step : e.key === 'ArrowDown' ? step : 0;
        const [x, y] = place(r.left + dx, r.top + dy);
        save(x, y);
      });
    }

    btn.addEventListener('click', () => say());

    // Eyes follow the pointer (anime characters only; skipped when motion is off).
    const iris = root.querySelectorAll<SVGGElement>('.ms-iris');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.dataset.motion === 'off';
    if (iris.length && !still) {
      let raf = 0;
      addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = btn.getBoundingClientRect();
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height * 0.45;
          const dx = clamp((e.clientX - cx) / 300, -1, 1);
          const dy = clamp((e.clientY - cy) / 300, -1, 1);
          iris.forEach((g) => {
            // The right eye is drawn mirrored, so its x offset flips.
            const sx = g.classList.contains('ms-iris-r') ? -1 : 1;
            g.style.transform = `translate(${(dx * 2.4 * sx).toFixed(2)}px, ${(dy * 1.8).toFixed(2)}px)`;
          });
        });
      }, { passive: true });
    }

    root.querySelector('[data-mascot-hide]')?.addEventListener('click', () => {
      sessionStorage.setItem('fn-mascot-hidden', '1');
      root.classList.add('is-leaving');
      setTimeout(() => (root.hidden = true), 400);
    });
  }
</script>

---
/**
 * Corner mascot. Three sources:
 *  - built-in characters: a layered rig (a real skeleton over the layers
 *    See-through split, see lib/lacia/rig.ts). All four — lacia / haru / sora /
 *    chibi — are the same renderer over different skin data.
 *  - a mascot pack (state images + anchors + lines, see lib/mascot-pack.ts),
 *  - a legacy single image URL.
 *
 * Behaviour: click to talk (time/page aware lines), drag anywhere (swings like
 * a held doll, lands with a bounce, snaps to screen edges and can peek from
 * them), position remembered per browser, double-click returns to the corner,
 * shrinks away when it would cover article text. Hidden under 900px and in print.
 */
import { MASCOT_LINES } from '../../lib/mascot/lines';
import { isMascotId } from '../../lib/mascot/meta';
import { MASCOT_STATES, type StoredMascotPack } from '../../lib/mascot-pack';
import { LACIA_LINES } from '../../lib/lacia/lines';
import { skinForCharacter, type LaciaSkinId } from '../../lib/lacia/rig';
import LaciaRigIsland from './LaciaRigIsland';
import '../../styles/mascot.css';

interface Props {
  character: string;
  /** Outfit for the rigged character; ignored by flat packs. */
  skin?: LaciaSkinId;
  /** Optional components to mount; undefined = whatever the outfit ships with. */
  components?: readonly string[];
  pack?: StoredMascotPack | null;
  draggable: boolean;
  imageUrl: string;
  position: 'right' | 'left';
  size: 'sm' | 'md' | 'lg';
  page: 'home' | 'article' | 'notFound' | 'other';
}
const { character, skin = 'suit', components, pack = null, draggable, imageUrl, position, size, page } = Astro.props;
const builtin = isMascotId(character) ? character : 'haru';
/* Which built-ins are a real skeleton over split layers rather than a flat
   drawing. This is the only place that forks on it — everything downstream
   (canvas size, pivots, face variants, mounted components) is skin data.
   All four are rigged now; the set stays so that adding a look which is *not*
   rigged fails loudly at the `kind` line instead of rendering nothing. */
const RIGGED = new Set<string>(['lacia', 'haru', 'sora', 'chibi']);
const rigged = !pack && !imageUrl && RIGGED.has(builtin);
const rigSkin = skinForCharacter(builtin, skin);
const kind = pack ? 'pack' : imageUrl ? 'image' : rigged ? 'rig' : 'none';
// Packs without their own generic lines still get something to say. The rigged
// character keeps her own voice: only 蕾西亚 has a written line set.
const lines = pack
  ? { ...pack.lines, click: pack.lines.click?.length ? pack.lines.click : MASCOT_LINES.haru }
  : builtin === 'lacia'
    ? LACIA_LINES
    : { click: MASCOT_LINES[builtin] };
const display = pack?.display;
const anchors = pack?.anchors;
const style = pack
  ? [
      `--ms-h:${display!.height}px`,
      `--ms-crop:${display!.crop}`,
      `--ms-ratio:${pack.width / pack.height}`,
      `--ms-bx:${anchors!.bubble[0]}`,
      `--ms-by:${anchors!.bubble[1]}`,
      `--ms-base:${anchors!.baseline}`,
      `--ms-hx:${anchors!.head[0]}`,
      `--ms-hy:${anchors!.head[1]}`,
    ].join(';')
  : undefined;
const payload = JSON.stringify({
  lines,
  page,
  motion: pack?.motion ?? null,
  hasBlink: !!pack?.urls.blink,
  // Anchors for the per-part warp: regions are derived from the head point and
  // the feet line, so an imported pack needs no extra assets.
  warp: pack ? { head: anchors!.head, baseline: anchors!.baseline, width: pack.width, height: pack.height } : null,
}).replace(/</g, '\\u003c');
---

<div
  class="mascot"
  data-pos={position}
  data-size={size}
  data-kind={kind}
  data-character={pack ? 'pack' : builtin}
  data-display={display?.mode}
  data-crop={display && display.crop < 1 ? '' : undefined}
  data-outline={display?.outline}
  data-shadow={display ? String(display.shadow) : undefined}
  data-flip={display?.flip ? '' : undefined}
  data-breathe={pack && !pack.motion.breathe ? 'off' : undefined}
  data-sway={pack && !pack.motion.sway ? 'off' : undefined}
  data-state="idle"
  data-mascot
  data-draggable={draggable ? '' : undefined}
  style={style}
>
  <script type="application/json" data-mascot-data set:html={payload} />
  <span class="mascot-bubble" data-mascot-bubble role="status" aria-live="polite"></span>
  <button
    type="button"
    class="mascot-btn"
    aria-label={draggable ? '看板娘：点击打招呼，拖动可移动位置，双击回到角落' : '看板娘（点击打招呼）'}
    data-mascot-btn
  >
    <span class="mascot-body" data-mascot-body>
      {
        pack ? (
          <span class="mascot-frames">
            {MASCOT_STATES.filter((s) => pack.urls[s]).map((s) => (
              s === 'idle' ? (
                /* `loading="lazy"` on purpose: below 900px the mascot is
                   `display: none`, and a lazy image with no box never
                   intersects the viewport, so phones do not fetch her at all.
                   On desktop she is in view from the first layout, so this
                   costs nothing there. */
                <img class="mascot-frame" data-frame={s} src={pack.urls[s]} alt="" draggable="false" decoding="async" loading="lazy" width={pack.width} height={pack.height} />
              ) : (
                /* `data-src`, not `src`: the frame is fetched when that state is
                   first used (or during idle time). Three frames are 200–240 KB
                   of WebP and only one is on screen at a time. */
                <img class="mascot-frame" data-frame={s} data-src={pack.urls[s]} alt="" draggable="false" decoding="async" width={pack.width} height={pack.height} />
              )
            ))}
          </span>
        ) : imageUrl ? (
          <img src={imageUrl} alt="" loading="lazy" decoding="async" draggable="false" />
        ) : (
          // The island server-renders the whole skeleton, so the figure is
          // painted before hydration and stays readable with JS off.
          // `client:media` and not `client:visible`: the CSS hides the mascot
          // below 900px, but `visible` still downloaded and parsed the whole
          // 11 KB (gz) rig engine on a phone, to drive an element that is not
          // displayed. A media query that does not match never even fetches
          // the chunk — and the server-rendered markup is still there, so the
          // figure is visible with no JS at all.
          <LaciaRigIsland client:media="(min-width: 901px)" variant="mascot" skin={rigSkin} components={components} autoForms />
        )
      }
    </span>
    <span class="mascot-shadow" aria-hidden="true"></span>
  </button>
  <button type="button" class="mascot-hide" aria-label="暂时隐藏看板娘" data-mascot-hide>×</button>
</div>

<script>
  import { pickLines, type LineGroup, type MascotPack } from '../../lib/mascot-pack';
  import type { WarpHandle } from '../../lib/mascot-warp';

  const root = document.querySelector<HTMLElement>('[data-mascot]');
  if (root) {
    if (sessionStorage.getItem('fn-mascot-hidden')) root.hidden = true;
    const data = JSON.parse(root.querySelector('[data-mascot-data]')!.textContent || '{}') as {
      lines: MascotPack['lines'];
      page: 'home' | 'article' | 'notFound' | 'other';
      motion: MascotPack['motion'] | null;
      hasBlink: boolean;
      warp: { head: [number, number]; baseline: number; width: number; height: number } | null;
    };
    const btn = root.querySelector<HTMLElement>('[data-mascot-btn]')!;
    const body = root.querySelector<HTMLElement>('[data-mascot-body]')!;
    const bubble = root.querySelector<HTMLElement>('[data-mascot-bubble]')!;
    const KEY = 'fn-mascot-pos';
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.dataset.motion === 'off';
    let talkTimer = 0;
    let stateTimer = 0;
    const used = new Map<string, number>();

    /* ---------------- state & lines ---------------- */
    // How hard the per-part motion runs in each state: asleep she barely
    // breathes, held she swings freely.
    let warpHandle: WarpHandle | null = null;
    /* Only the idle frame ships with a `src`. A pack's frames are 60–90 KB each
       and the mascot shows one at a time, so the other two are a `data-src`
       until something actually asks for that state — that is 160 KB of WebP
       taken off first paint on every page. Idle keeps its `src` so a reader
       without JS still sees her. */
    const hydrateFrame = (s: string) => {
      const img = root.querySelector<HTMLImageElement>(`.mascot-frame[data-frame="${s}"]`);
      if (img && !img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
      return img;
    };
    const energyFor = (s: string) => (s === 'held' ? 1.7 : s === 'sleep' ? 0.4 : 1);
    const commit = (s: string, ms: number) => {
      root.dataset.state = s;
      /* A pack is a stack of bitmaps and the rig renders itself, so neither has
         anything to run here: the state is a `data-state` for the pack's CSS and
         an event for the rig engine, which owns its own springs. */
      warpHandle?.setEnergy(energyFor(s));
      root.dispatchEvent(new CustomEvent('lacia:state', { detail: s }));
      // Fall back to held, not idle, if she is still being carried — otherwise
      // a long drag drops the motion back to idle mid-air after the line ends.
      if (ms) stateTimer = window.setTimeout(() => setState(root.classList.contains('is-dragging') ? 'held' : 'idle'), ms);
    };
    const setState = (s: string, ms = 0) => {
      clearTimeout(stateTimer);
      /* The frame for this state may still be on its way (it is only fetched
         when first needed). Flipping `data-state` now would fade idle out and
         fade in an image with no pixels yet, so hold the switch until it can
         paint — capped, because a slow frame must not swallow the state. */
      const img = hydrateFrame(s);
      if (img && !img.complete && root.dataset.state !== s) {
        let done = false;
        const go = () => {
          if (done) return;
          done = true;
          commit(s, ms);
        };
        img.addEventListener('load', go, { once: true });
        img.addEventListener('error', go, { once: true });
        setTimeout(go, 250);
        return;
      }
      commit(s, ms);
    };
    const line = (group: LineGroup): string | undefined => {
      const list = pickLines({ lines: data.lines }, group);
      if (!list.length) return undefined;
      const i = ((used.get(group) ?? Math.floor(Math.random() * list.length)) + 1) % list.length;
      used.set(group, i);
      return list[i];
    };
    const timeGroup = (): LineGroup | null => {
      const h = new Date().getHours();
      if (h >= 23 || h < 5) return 'night';
      if (h >= 5 && h < 11) return 'morning';
      if (h >= 11 && h < 14) return 'noon';
      if (h >= 17 && h < 20) return 'evening';
      return null;
    };
    const say = (text: string | undefined, state = 'talk') => {
      if (!text) return;
      bubble.textContent = text;
      root.classList.remove('is-talking');
      void root.offsetWidth;
      root.classList.add('is-talking');
      setState(state, 3400);
      clearTimeout(talkTimer);
      talkTimer = window.setTimeout(() => root.classList.remove('is-talking'), 3400);
    };
    const clickLine = () => {
      // Mix in context: time of day first, then the page, then generic lines.
      const r = Math.random();
      const t = timeGroup();
      const pageGroup = ({ home: 'home', article: 'article', notFound: 'notFound', other: null } as const)[data.page];
      if (t && r < 0.3 && data.lines[t]?.length) return line(t);
      if (pageGroup && r < 0.55 && data.lines[pageGroup]?.length) return line(pageGroup);
      return line('click');
    };

    /* ---------------- blinking (packs with a blink frame) ---------------- */
    if (data.hasBlink && !still) {
      const every = (data.motion?.blinkEvery ?? 5) * 1000;
      const blink = () => {
        if (root.dataset.state === 'idle' && !document.hidden) {
          /* Skip the cycle while the blink frame is still loading — a 140 ms
             flash is not worth showing an empty box, and the next one is 5 s
             away, by which time it is decoded. */
          const img = hydrateFrame('blink');
          if (img && img.complete) {
            root.dataset.state = 'blink';
            setTimeout(() => { if (root.dataset.state === 'blink') root.dataset.state = 'idle'; }, 140);
          }
        }
        setTimeout(blink, every * (0.6 + Math.random() * 0.8));
      };
      setTimeout(blink, every);
    }
    // Sleep late at night after a minute without interaction.
    let idleTimer = 0;
    const wake = () => {
      if (root.dataset.state === 'sleep') setState('idle');
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => { if (timeGroup() === 'night' && root.dataset.state === 'idle') setState('sleep'); }, 60_000);
    };
    ['pointermove', 'keydown', 'scroll'].forEach((e) => addEventListener(e, wake, { passive: true }));
    wake();

    /* Bring the remaining frames in when the browser has nothing better to do —
       after first paint, before the reader is likely to click her. Skipped
       entirely below 901px: the CSS hides the mascot there, so those bytes
       would be spent on an element that is never painted. */
    const prefetchFrames = () => {
      if (!matchMedia('(min-width: 901px)').matches) return;
      for (const img of root.querySelectorAll<HTMLImageElement>('.mascot-frame[data-src]')) {
        if (!img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
      }
    };
    const idleCb = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
    if (document.readyState === 'complete') idleCb ? idleCb(prefetchFrames, { timeout: 3000 }) : setTimeout(prefetchFrames, 1500);
    else addEventListener('load', () => (idleCb ? idleCb(prefetchFrames, { timeout: 3000 }) : setTimeout(prefetchFrames, 1500)), { once: true });

    /* ---------------- per-part motion (displacement warp) ---------------- */
    // A pack is one flat bitmap, so the head, hair and torso are warped by an
    // SVG displacement filter instead of being split into layers. See
    // lib/mascot-warp.ts for why layer splitting is not viable.
    /* Loaded on demand: only a bitmap pack uses the displacement field, and the
       built-in characters are SVG or a rig. Importing it statically put ~3 KB
       (gz) of filter code on every page for a branch that never runs there. */
    const frames = root.querySelector<HTMLElement>('.mascot-frames');
    if (frames && data.warp && data.motion?.warp !== false && !still) {
      void import('../../lib/mascot-warp').then(({ attachWarp }) => {
        const handle = attachWarp(frames, {
          width: data.warp!.width,
          height: data.warp!.height,
          head: data.warp!.head,
          baseline: data.warp!.baseline,
          intensity: data.motion?.warpIntensity ?? 1,
        });
        if (!handle) return;
        warpHandle = handle;
        handle.start();
        /* A state may have changed while the module was in flight; the current
           one is the truth, not the one captured above. */
        handle.setEnergy(energyFor(root.dataset.state ?? 'idle'));
        // No point burning frames on a tab nobody is looking at.
        document.addEventListener('visibilitychange', () => (document.hidden ? warpHandle?.stop() : warpHandle?.start()));
        addEventListener('pagehide', () => handle.destroy(), { once: true });
      });
    }

    /* ---------------- position ---------------- */
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const SNAP = 28;
    const place = (x: number, y: number, snap = false) => {
      const w = root.offsetWidth;
      const h = root.offsetHeight;
      let px = clamp(x, 0, innerWidth - w);
      const py = clamp(y, 0, innerHeight - h);
      let edge = '';
      if (snap && px < SNAP) { px = 0; edge = 'left'; }
      if (snap && px > innerWidth - w - SNAP) { px = innerWidth - w; edge = 'right'; }
      root.style.left = `${px}px`;
      root.style.top = `${py}px`;
      root.style.right = 'auto';
      root.style.bottom = 'auto';
      root.classList.add('is-free');
      root.dataset.edge = edge;
      root.dataset.bubble = px + w / 2 > innerWidth / 2 ? 'left' : 'right';
      return [px, py] as const;
    };
    const save = (x: number, y: number) => localStorage.setItem(KEY, JSON.stringify({ fx: x / innerWidth, fy: y / innerHeight }));
    const reset = () => {
      localStorage.removeItem(KEY);
      root.classList.remove('is-free');
      root.style.left = root.style.top = root.style.right = root.style.bottom = '';
      delete root.dataset.bubble;
      delete root.dataset.edge;
    };
    const restore = () => {
      try {
        const p = JSON.parse(localStorage.getItem(KEY) ?? 'null') as { fx: number; fy: number } | null;
        if (p && Number.isFinite(p.fx) && Number.isFinite(p.fy)) place(p.fx * innerWidth, p.fy * innerHeight, true);
      } catch { /* ignore */ }
    };

    /* ---------------- drag with pendulum swing ---------------- */
    const draggable = root.hasAttribute('data-draggable');
    if (draggable) {
      requestAnimationFrame(restore);
      addEventListener('resize', () => { if (root.classList.contains('is-free')) restore(); });

      let start: { x: number; y: number; left: number; top: number; id: number } | null = null;
      let moved = false;
      let angle = 0;
      let vel = 0;
      let lastX = 0;
      let raf = 0;
      const swing = () => {
        // damped pendulum driven by horizontal pointer velocity
        vel += -angle * 0.12;
        vel *= 0.86;
        angle += vel;
        body.style.transform = `rotate(${angle.toFixed(2)}deg)`;
        if (moved || Math.abs(angle) > 0.05 || Math.abs(vel) > 0.05) raf = requestAnimationFrame(swing);
        else body.style.transform = '';
      };
      btn.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        const r = root.getBoundingClientRect();
        start = { x: e.clientX, y: e.clientY, left: r.left, top: r.top, id: e.pointerId };
        lastX = e.clientX;
        moved = false;
      });
      btn.addEventListener('pointermove', (e) => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x;
        const dy = e.clientY - start.y;
        if (!moved && Math.hypot(dx, dy) < 5) return;
        if (!moved) {
          moved = true;
          btn.setPointerCapture(e.pointerId);
          root.classList.add('is-dragging');
          setState('held');
          say(line('drag') ?? '哇——', 'held');
          if (!still && data.motion?.swing !== false) { cancelAnimationFrame(raf); raf = requestAnimationFrame(swing); }
        }
        if (!still) vel -= (e.clientX - lastX) * 0.06;
        lastX = e.clientX;
        place(start.left + dx, start.top + dy);
      });
      const end = (e: PointerEvent) => {
        if (!start || e.pointerId !== start.id) return;
        if (moved) {
          root.classList.remove('is-dragging');
          const r = root.getBoundingClientRect();
          const [x, y] = place(r.left, r.top, true);
          save(x, y);
          if (!still) {
            root.classList.remove('is-landing');
            void root.offsetWidth;
            root.classList.add('is-landing');
            setTimeout(() => root.classList.remove('is-landing'), 520);
          }
          say(line('drop') ?? '放好啦。', 'happy');
        }
        start = null;
        // `moved` is cleared by the click handler below.
        setTimeout(() => (moved = false), 0);
      };
      btn.addEventListener('pointerup', end);
      btn.addEventListener('pointercancel', end);
      btn.addEventListener('click', (e) => { if (moved) e.stopImmediatePropagation(); }, true);
      btn.addEventListener('dblclick', () => { reset(); say(line('reset') ?? '回到老位置啦。', 'happy'); });
      btn.addEventListener('keydown', (e) => {
        if (!e.altKey || !e.key.startsWith('Arrow')) return;
        e.preventDefault();
        const r = root.getBoundingClientRect();
        const step = e.shiftKey ? 60 : 20;
        const dx = e.key === 'ArrowLeft' ? -step : e.key === 'ArrowRight' ? step : 0;
        const dy = e.key === 'ArrowUp' ? -step : e.key === 'ArrowDown' ? step : 0;
        const [x, y] = place(r.left + dx, r.top + dy, true);
        save(x, y);
      });
    }

    btn.addEventListener('click', () => {
      // Peeking from an edge: the first click pops her out.
      if (root.dataset.edge && !root.classList.contains('is-out')) {
        root.classList.add('is-out');
        setTimeout(() => root.classList.remove('is-out'), 4000);
      }
      root.dispatchEvent(new CustomEvent('lacia:poke'));
      say(clickLine(), Math.random() < 0.3 ? 'happy' : 'talk');
    });
    // A rigged character reports device-form changes; each form has its own
    // line group, so the four modes speak for themselves.
    const FORM_GROUP: Record<string, LineGroup> = { coffin: 'formCoffin', railgun: 'formRailgun', shield: 'formShield', unfold: 'formUnfold' };
    root.addEventListener('lacia:form', (e) => {
      const d = (e as CustomEvent<{ form: string; manual: boolean }>).detail;
      // Passive cycles stay silent — the device lighting up is the message.
      if (!d?.manual) return;
      say(line(FORM_GROUP[d.form] ?? 'click'));
    });
    addEventListener('fn:read-end', () => say(line('readEnd') ?? '读完啦！', 'happy'));
    // A greeting on arrival on the 404 page.
    if (data.page === 'notFound') setTimeout(() => say(line('notFound')), 1200);

    /* ---------------- stay clear of article text ---------------- */
    const article = document.querySelector<HTMLElement>('.article, .prose, article');
    if (article && 'IntersectionObserver' in window) {
      const check = () => {
        const a = article.getBoundingClientRect();
        const m = root.getBoundingClientRect();
        const overlap = m.left < a.right && m.right > a.left && m.top < a.bottom && m.bottom > a.top;
        root.classList.toggle('is-shy', overlap && !root.classList.contains('is-dragging'));
      };
      let t = 0;
      addEventListener('scroll', () => { if (!t) t = requestAnimationFrame(() => { t = 0; check(); }); }, { passive: true });
      addEventListener('resize', check);
      setTimeout(check, 400);
    }

    /* Eyes following the pointer used to live here. It moved into the rig
       engine (`lib/lacia/rig.ts`) when the built-in characters stopped being
       hand-drawn SVG: the eyes are bitmaps on a bone now, so "look at the
       pointer" is a transform on that bone, not a class swap. */

    root.querySelector('[data-mascot-hide]')?.addEventListener('click', () => {
      sessionStorage.setItem('fn-mascot-hidden', '1');
      root.classList.add('is-leaving');
      setTimeout(() => (root.hidden = true), 400);
    });
  }
</script>

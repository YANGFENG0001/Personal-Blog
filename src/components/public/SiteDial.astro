---
import { iconSvg } from '../../lib/icons';
import type { Site, Category } from '../../server/services/sites';
import type { Settings } from '../../server/seed';

interface Props {
  sites: (Site & { categories: Category[] })[];
  currentSiteId?: string | null;
  config: Settings['dial'];
  monogram: string;
}

const { sites, currentSiteId, config: c, monogram } = Astro.props;
const n = Math.max(sites.length, 1);
const layout = c.layout;
const showOrbit = (layout === 'orbit' || layout === 'arc') && c.showOrbit;
const showList = layout === 'list' || (layout !== 'rail' && c.showList);

/** Node positions as percentages of the orbit box. */
function position(i: number) {
  if (layout === 'arc') {
    // Ellipse centred on the panel's left edge (6%, 50%), radii 78% × 42%.
    const span = Math.min(140, 30 * (n - 1));
    const deg = n === 1 ? 0 : -span / 2 + (span / (n - 1)) * i;
    const a = (deg * Math.PI) / 180;
    return { x: 6 + Math.cos(a) * 78, y: 50 + Math.sin(a) * 42 };
  }
  const a = (-90 + (360 / n) * i) * (Math.PI / 180);
  return { x: 50 + Math.cos(a) * 39, y: 50 + Math.sin(a) * 39 };
}
const current = sites.find((s) => s.id === currentSiteId);
---

<nav class="dial" data-dial data-layout={layout} data-shape={c.shape} data-handle={c.handle} style={`--dial-y:${c.offsetY}%`} aria-label="分站切换">
  <button class="dial-handle" type="button" aria-expanded="false" aria-controls="dial-panel" data-dial-toggle title="切换分站 (Alt+S)">
    <span class="sr-only">展开分站切换器</span>
    {c.handle === 'tab' && <span class="dial-handle-mark" aria-hidden="true">{current ? current.name.slice(0, 1) : monogram}</span>}
    {c.handle === 'tab' && <Fragment set:html={iconSvg('chevron-right', 'dial-handle-chev')} />}
    {c.handle === 'dot' && <span class="dial-dot" aria-hidden="true" />}
    {c.handle === 'line' && <span class="dial-line" aria-hidden="true" />}
  </button>
  <div class="dial-panel" id="dial-panel">
    <span class="dial-grab" aria-hidden="true"></span>
    {c.showTitle && layout !== 'rail' && <div class="dial-label">SITES · 分站</div>}

    {
      showOrbit && (
        <div class="dial-orbit">
          <span class="dial-ring" aria-hidden="true" />
          <a class="dial-center" href="/" aria-label="首页" title="首页">
            {monogram}
          </a>
          {sites.map((s, i) => {
            const p = position(i);
            return (
              <a
                class:list={['dial-node', 'anim-icon', { active: s.id === currentSiteId }]}
                href={`/${s.slug}`}
                style={`left:${p.x.toFixed(2)}%;top:${p.y.toFixed(2)}%;--i:${i}`}
                aria-current={s.id === currentSiteId ? 'page' : undefined}
                aria-label={s.name}
                data-dial-node
                tabindex={showList ? -1 : undefined}
              >
                <Fragment set:html={iconSvg(s.icon)} />
                <span class="dial-tip" aria-hidden="true">{s.name}</span>
              </a>
            );
          })}
        </div>
      )
    }

    {
      layout === 'rail' && (
        <ul class="dial-rail" role="list">
          <li style="--i:0">
            <a class="dial-rail-item" href="/" data-dial-item aria-label="首页">
              <span class="dial-rail-icon">{monogram}</span>
              {c.showTitle ? <span class="dial-rail-name">首页</span> : <span class="dial-tip" aria-hidden="true">首页</span>}
            </a>
          </li>
          {sites.map((s, i) => (
            <li style={`--i:${i + 1}`}>
              <a
                href={`/${s.slug}`}
                class:list={['dial-rail-item', 'anim-icon', { active: s.id === currentSiteId }]}
                aria-current={s.id === currentSiteId ? 'page' : undefined}
                aria-label={s.name}
                data-dial-item
              >
                <span class="dial-rail-icon" set:html={iconSvg(s.icon)} />
                {c.showTitle ? <span class="dial-rail-name">{s.name}</span> : <span class="dial-tip" aria-hidden="true">{s.name}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      showList && (
        <ul class="dial-list" role="list">
          {sites.map((s, i) => (
            <li style={`--i:${i}`}>
              <a
                href={`/${s.slug}`}
                class:list={['anim-icon', { active: s.id === currentSiteId }]}
                aria-current={s.id === currentSiteId ? 'page' : undefined}
                data-dial-item
              >
                {layout === 'list' && <span class="dial-list-icon" set:html={iconSvg(s.icon)} />}
                <span class="dial-list-name">{s.name}</span>
                {c.showEnglish && <small>{s.enName}</small>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {c.showHint && layout !== 'rail' && <div class="dial-foot">Alt+S 打开 · ↑↓ 选择 · Esc 收起</div>}
  </div>
</nav>
<div class="dial-scrim" data-dial-scrim aria-hidden="true"></div>

<style>
  .dial {
    --dial-w: 240px;
    position: fixed; left: 0; top: var(--dial-y, 50%); z-index: 60; display: flex; align-items: center;
    transform: translate(calc(-100% + 30px), -50%);
    transition: transform calc(0.55s * var(--dur)) var(--ease);
  }
  .dial[data-handle='dot'], .dial[data-handle='line'] { transform: translate(calc(-100% + 18px), -50%); }
  .dial[data-layout='rail'] { --dial-w: auto; }
  .dial[data-layout='list'] { --dial-w: 212px; }
  .dial[data-open], .dial:focus-within { transform: translate(0, -50%); }
  @media (hover: hover) { .dial:hover { transform: translate(0, -50%); } }

  /* ---------- panel & shapes ---------- */
  .dial-panel {
    position: relative; width: var(--dial-w); padding: 18px 18px 14px 20px;
    background: color-mix(in srgb, var(--surface) 94%, transparent); backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid var(--line); border-left: 0; border-radius: 0 var(--r-lg) var(--r-lg) 0;
    transition: box-shadow calc(0.4s * var(--dur));
  }
  .dial[data-open] .dial-panel, .dial:focus-within .dial-panel { box-shadow: var(--shadow); }
  @media (hover: hover) { .dial:hover .dial-panel { box-shadow: var(--shadow); } }
  .dial[data-shape='capsule'] .dial-panel { border-radius: 0 999px 999px 0; padding-right: 32px; }
  .dial[data-shape='half'] .dial-panel { border-radius: 0 50% 50% 0 / 0 50% 50% 0; padding: 30px 48px 30px 22px; }
  .dial[data-shape='leaf'] .dial-panel { border-radius: 0 48px 0 48px; }
  .dial[data-shape='glass'] .dial-panel { background: color-mix(in srgb, var(--surface) 45%, transparent); backdrop-filter: blur(22px) saturate(1.6); border-color: color-mix(in srgb, var(--ink) 8%, transparent); }
  .dial[data-layout='rail'] .dial-panel { padding: 10px 8px 10px 10px; }
  .dial[data-layout='rail'][data-shape='half'] .dial-panel { padding: 22px 16px 22px 10px; }
  .dial[data-layout='arc'] .dial-panel { overflow: hidden; }
  .dial-grab { display: none; }

  /* ---------- handle ---------- */
  .dial-handle {
    order: 1; /* the handle is the part that stays visible at the screen edge */
    border: 1px solid var(--line); border-left: 0; background: var(--surface); color: var(--accent);
    display: grid; place-items: center; align-content: center; gap: 4px; padding: 0; cursor: pointer;
    transition: width calc(0.3s * var(--dur)) var(--ease);
  }
  .dial[data-handle='tab'] .dial-handle { height: 88px; width: 30px; border-radius: 0 16px 16px 0; box-shadow: 6px 4px 18px color-mix(in srgb, var(--ink) 6%, transparent); }
  .dial[data-handle='tab'] .dial-handle:hover { width: 34px; }
  .dial:is([data-shape='capsule'], [data-shape='half'])[data-handle='tab'] .dial-handle { border-radius: 0 999px 999px 0; }
  .dial[data-handle='dot'] .dial-handle { width: 18px; height: 48px; border: 0; background: transparent; }
  .dial[data-handle='line'] .dial-handle { width: 18px; height: 80px; border: 0; background: transparent; }
  .dial-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); animation: dial-breathe calc(3s * var(--dur)) ease-in-out infinite; }
  @keyframes dial-breathe { 50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 6%, transparent); } }
  .dial-line { width: 4px; height: 56px; border-radius: 4px; background: color-mix(in srgb, var(--accent) 55%, transparent); transition: height calc(0.3s * var(--dur)) var(--ease), background 0.2s; }
  .dial:hover .dial-line { height: 70px; background: var(--accent); }
  .dial-handle-mark { font: 14px var(--display); }
  .dial-handle :global(.dial-handle-chev) { width: 14px; height: 14px; transition: transform calc(0.4s * var(--dur)) var(--ease); }
  .dial[data-open] .dial-handle :global(.dial-handle-chev) { transform: rotate(180deg); }
  .dial-label { font-size: 10px; letter-spacing: 0.2em; color: var(--faint); }

  /* ---------- orbit / arc ---------- */
  .dial-orbit { position: relative; width: 140px; height: 140px; margin: 10px auto 8px; }
  .dial[data-layout='arc'] .dial-orbit { width: 150px; height: 170px; margin: 6px 0 6px -20px; }
  .dial-ring { position: absolute; inset: 11%; border: 1px solid var(--line); border-radius: 50%; transition: transform calc(1.1s * var(--dur)) var(--ease); }
  .dial-ring::after { content: ''; position: absolute; inset: 12px; border: 1px dashed var(--line); border-radius: 50%; }
  /* The arc ring is exactly the ellipse the nodes sit on. */
  .dial[data-layout='arc'] .dial-ring { inset: auto; left: -72%; top: 8%; width: 156%; height: 84%; }
  .dial:is(:hover, [data-open]) .dial-ring { transform: rotate(50deg); }
  .dial[data-layout='arc']:is(:hover, [data-open]) .dial-ring { transform: rotate(12deg); }
  .dial-center {
    position: absolute; left: 50%; top: 50%; width: 38px; height: 38px; transform: translate(-50%, -50%);
    border: 1px solid var(--accent); color: var(--accent); border-radius: 50%; display: grid; place-items: center;
    font: italic 17px Georgia, var(--serif); background: var(--surface); transition: background 0.2s, color 0.2s;
  }
  .dial-center:hover { background: var(--accent); color: var(--on-accent); }
  .dial[data-layout='arc'] .dial-center { left: 6%; }
  .dial-node {
    position: absolute; width: 32px; height: 32px; transform: translate(-50%, -50%) scale(0.6); opacity: 0; border-radius: 50%;
    border: 1px solid var(--line); background: var(--surface); display: grid; place-items: center; color: var(--muted);
    transition: transform calc(0.45s * var(--dur)) var(--spring) calc(var(--i) * 40ms * var(--dur)), opacity calc(0.3s * var(--dur)) calc(var(--i) * 40ms * var(--dur)),
      border-color 0.2s, background 0.2s, color 0.2s;
  }
  .dial:is([data-open], :focus-within) .dial-node { transform: translate(-50%, -50%); opacity: 1; }
  @media (hover: hover) { .dial:hover .dial-node { transform: translate(-50%, -50%); opacity: 1; } }
  .dial-node :global(svg) { width: 15px; height: 15px; }
  .dial .dial-node:is(:hover, :focus-visible) { transform: translate(-50%, -50%) scale(1.18); transition-delay: 0s; border-color: var(--accent); color: var(--accent); z-index: 2; }
  .dial-node.active { background: var(--accent); color: var(--on-accent); border-color: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 16%, transparent); }
  .dial-tip {
    position: absolute; left: calc(100% + 8px); top: 50%; transform: translate(-4px, -50%); white-space: nowrap; pointer-events: none; z-index: 3;
    font-size: 11px; padding: 2px 8px; border-radius: 999px; background: var(--ink); color: var(--bg); opacity: 0; transition: opacity 0.15s, transform 0.2s var(--ease);
  }
  :is(.dial-node, .dial-rail-item):is(:hover, :focus-visible) .dial-tip { opacity: 1; transform: translate(0, -50%); }
  .dial[data-layout='arc'] .dial-tip { display: none; }

  /* ---------- list ---------- */
  .dial-list { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 2px; }
  .dial-list li, .dial-rail li {
    opacity: 0; transform: translateX(-8px);
    transition: opacity calc(0.3s * var(--dur)) calc(var(--i) * 35ms * var(--dur) + 80ms), transform calc(0.4s * var(--dur)) var(--ease) calc(var(--i) * 35ms * var(--dur) + 80ms);
  }
  .dial:is([data-open], :focus-within) :is(.dial-list, .dial-rail) li { opacity: 1; transform: none; }
  @media (hover: hover) { .dial:hover :is(.dial-list, .dial-rail) li { opacity: 1; transform: none; } }
  .dial-list a { position: relative; display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: var(--r-sm); font-size: 13px; color: var(--muted); transition: background 0.15s, color 0.15s, padding 0.2s var(--ease); }
  .dial-list-name { flex: 1; }
  .dial-list-icon { color: var(--faint); display: grid; }
  .dial-list-icon :global(svg) { width: 16px; height: 16px; }
  .dial-list a small { font-size: 9px; letter-spacing: 0.14em; color: var(--faint); }
  .dial-list a:is(:hover, :focus-visible) { background: var(--tint); color: var(--accent); padding-left: 14px; }
  .dial-list a.active { background: var(--tint); color: var(--accent); font-weight: 650; }
  .dial-list a.active::before { content: ''; position: absolute; left: 0; top: 7px; bottom: 7px; width: 2px; border-radius: 2px; background: var(--accent); }
  .dial-list a:is(:hover, .active) .dial-list-icon { color: var(--accent); }
  .dial-foot { text-align: center; font-size: 10px; color: var(--faint); margin-top: 10px; }

  /* ---------- rail ---------- */
  .dial-rail { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .dial-rail-item { position: relative; display: flex; align-items: center; gap: 10px; padding: 4px; border-radius: var(--r); color: var(--muted); font-size: 13px; transition: background 0.15s, color 0.15s; }
  .dial-rail-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--r); border: 1px solid var(--line); background: var(--surface); font: italic 16px Georgia, var(--serif); color: var(--accent); flex: none; transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .dial-rail-icon :global(svg) { width: 16px; height: 16px; }
  .dial-rail-item:is(:hover, :focus-visible) { color: var(--accent); background: var(--tint); }
  .dial-rail-item:hover .dial-rail-icon { border-color: var(--accent); }
  .dial-rail-item.active .dial-rail-icon { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .dial-rail-name { padding-right: 10px; white-space: nowrap; }

  .dial-scrim { display: none; }

  /* ---------- Touch / small screens: bottom sheet ---------- */
  @media (max-width: 760px), (hover: none) {
    .dial, .dial[data-handle] { top: auto; bottom: 18px; transform: none; }
    .dial[data-open] { transform: none; }
    .dial-handle, .dial[data-handle] .dial-handle { height: 44px; width: 32px; border-radius: 0 12px 12px 0; border: 1px solid var(--line); border-left: 0; background: var(--surface); }
    .dial-handle-mark, .dial-line { display: none; }
    .dial[data-handle='line'] .dial-handle::after { content: ''; width: 3px; height: 18px; border-radius: 3px; background: var(--accent); }
    .dial-panel, .dial[data-shape] .dial-panel {
      position: fixed; left: 0; right: 0; bottom: 0; width: auto; border-radius: 18px 18px 0 0; border: 1px solid var(--line);
      padding: 10px 18px max(18px, env(safe-area-inset-bottom)); background: var(--surface); backdrop-filter: none; box-shadow: var(--shadow);
      transform: translateY(105%); transition: transform calc(0.42s * var(--dur)) var(--ease); overflow: visible;
    }
    .dial[data-open] .dial-panel { transform: none; }
    .dial-grab { display: block; width: 40px; height: 4px; border-radius: 4px; background: var(--line); margin: 0 auto 12px; }
    .dial-orbit, .dial-foot { display: none; }
    .dial-list, .dial-rail { grid-template-columns: repeat(2, 1fr); gap: 6px; margin-top: 10px; }
    .dial-list li, .dial-rail li { opacity: 1; transform: none; }
    .dial-list a, .dial-rail-item { padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r); }
    .dial-list a:is(:hover, :focus-visible) { padding-left: 12px; }
    .dial-tip { display: none; }
    .dial-scrim { display: block; position: fixed; inset: 0; z-index: 59; background: color-mix(in srgb, #000 30%, transparent); opacity: 0; pointer-events: none; transition: opacity calc(0.3s * var(--dur)); }
    .dial[data-open] + .dial-scrim { opacity: 1; pointer-events: auto; }
  }
</style>

<script>
  function setup() {
    const dial = document.querySelector<HTMLElement>('[data-dial]');
    if (!dial || dial.dataset.ready) return;
    dial.dataset.ready = '1';
    const toggle = dial.querySelector<HTMLButtonElement>('[data-dial-toggle]')!;
    const items = () => {
      const list = [...dial.querySelectorAll<HTMLAnchorElement>('[data-dial-item]')];
      return list.length ? list : [...dial.querySelectorAll<HTMLAnchorElement>('[data-dial-node]')];
    };
    const open = (focus = false) => {
      dial.dataset.open = '';
      toggle.setAttribute('aria-expanded', 'true');
      if (focus) (items().find((a) => a.classList.contains('active')) ?? items()[0])?.focus();
    };
    const close = (refocus = false) => {
      delete dial.dataset.open;
      toggle.setAttribute('aria-expanded', 'false');
      if (refocus) toggle.focus();
    };
    toggle.addEventListener('click', () => ('open' in dial.dataset ? close() : open(true)));
    document.querySelector('[data-dial-scrim]')?.addEventListener('click', () => close());
    dial.addEventListener('keydown', (e) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape') { close(true); e.preventDefault(); }
      else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { list[(i + 1) % list.length]?.focus(); e.preventDefault(); }
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { list[(i - 1 + list.length) % list.length]?.focus(); e.preventDefault(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.altKey && (e.key === 's' || e.key === 'S')) { e.preventDefault(); open(true); }
    });
    document.addEventListener('click', (e) => { if (!dial.contains(e.target as Node)) close(); });
    // Swipe down on the bottom sheet to close it.
    const panel = dial.querySelector<HTMLElement>('.dial-panel');
    let y0 = 0;
    panel?.addEventListener('touchstart', (e) => (y0 = e.touches[0]!.clientY), { passive: true });
    panel?.addEventListener('touchend', (e) => { if (e.changedTouches[0]!.clientY - y0 > 60) close(); });
  }
  setup();
</script>

---
import { dialHtml } from '../../lib/dial';
import type { Site, Category } from '../../server/services/sites';
import type { Settings } from '../../server/seed';
import '../../styles/dial.css';

interface Props {
  sites: (Site & { categories: Category[] })[];
  currentSiteId?: string | null;
  config: Settings['dial'];
  monogram: string;
}

const { sites, currentSiteId, config, monogram } = Astro.props;
const html = dialHtml(config, sites, currentSiteId, monogram);
---

<Fragment set:html={html} />
<div class="dial-scrim" data-dial-scrim aria-hidden="true"></div>

<script>
  function setup() {
    const dial = document.querySelector<HTMLElement>('[data-dial]');
    if (!dial || dial.dataset.ready) return;
    dial.dataset.ready = '1';
    const toggle = dial.querySelector<HTMLButtonElement>('[data-dial-toggle]')!;
    // Only items currently rendered (desktop layout vs. mobile sheet) take part in keyboard navigation.
    const items = () => [...dial.querySelectorAll<HTMLAnchorElement>('[data-dial-item], [data-dial-sheet]')].filter((a) => a.offsetParent !== null);
    const open = (focus = false) => {
      dial.dataset.open = '';
      toggle.setAttribute('aria-expanded', 'true');
      if (focus) requestAnimationFrame(() => (items().find((a) => a.classList.contains('active')) ?? items()[0])?.focus());
    };
    const close = (refocus = false) => {
      delete dial.dataset.open;
      toggle.setAttribute('aria-expanded', 'false');
      if (refocus) toggle.focus();
    };
    toggle.addEventListener('click', () => ('open' in dial.dataset ? close() : open(true)));
    document.querySelector('[data-dial-scrim]')?.addEventListener('click', () => close());
    dial.addEventListener('keydown', (e) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape') { close(true); e.preventDefault(); }
      else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { list[(i + 1) % list.length]?.focus(); e.preventDefault(); }
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { list[(i - 1 + list.length) % list.length]?.focus(); e.preventDefault(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.altKey && (e.key === 's' || e.key === 'S')) { e.preventDefault(); open(true); }
    });
    document.addEventListener('click', (e) => { if (!dial.contains(e.target as Node)) close(); });

    // Half-circle fan: the hub names whichever site is hovered or focused.
    const label = dial.querySelector<HTMLElement>('[data-fan-label]');
    if (label) {
      const rest = label.textContent ?? '';
      dial.querySelectorAll<HTMLElement>('.fan-node, .fan-hub').forEach((n) => {
        const show = () => (label.textContent = n.dataset.name ?? rest);
        n.addEventListener('pointerenter', show);
        n.addEventListener('focus', show);
        n.addEventListener('pointerleave', () => (label.textContent = rest));
        n.addEventListener('blur', () => (label.textContent = rest));
      });
    }

    // Swipe down on the bottom sheet to close it.
    const panel = dial.querySelector<HTMLElement>('.dial-panel');
    let y0 = 0;
    panel?.addEventListener('touchstart', (e) => (y0 = e.touches[0]!.clientY), { passive: true });
    panel?.addEventListener('touchend', (e) => { if (e.changedTouches[0]!.clientY - y0 > 60) close(); });
  }
  setup();
</script>

---
/**
 * Floating ball for the authenticated owner only. Rendered server-side solely
 * when a valid owner session exists, so visitors never receive it.
 * In the workspace it opens the public site; on the public site it returns.
 */
import type { Settings } from '../server/seed';

interface Props {
  mode: 'owner' | 'visitor';
  config: Settings['previewBall'];
}
const { mode, config } = Astro.props;
const href = mode === 'owner' ? '/' : '/owner';
const label = mode === 'owner' ? '以游客视角预览网站' : '返回站主工作台';
const text = mode === 'owner' ? '游客预览' : '预览中 · 返回工作台';
---

<a
  class="pball"
  href={href}
  data-pos={config.position}
  data-mode={mode}
  data-shape={config.shape}
  data-style={config.style}
  data-size={config.size}
  data-label={config.showLabel ? 'on' : 'off'}
  data-pulse={config.pulse ? 'on' : 'off'}
  aria-label={label}
  title={label}
>
  <span class="pball-core" aria-hidden="true">
    {
      mode === 'owner' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z" />
        </svg>
      )
    }
  </span>
  <span class="pball-label">{text}</span>
</a>

<style is:global>
  /* Shared with the appearance-page preview (.pball inside .ball-stage). */
  .pball {
    --pb: 48px;
    position: fixed; bottom: 26px; z-index: 120; display: flex; align-items: center; height: var(--pb); min-width: var(--pb);
    background: var(--ink); color: var(--bg); box-shadow: var(--shadow); border-radius: 999px;
    transition: padding calc(0.35s * var(--dur)) var(--ease), transform calc(0.3s * var(--dur)) var(--spring), box-shadow 0.2s, border-radius calc(0.3s * var(--dur));
  }
  .pball:active { transform: scale(0.94); }
  .pball[data-size='sm'] { --pb: 40px; }
  .pball[data-size='lg'] { --pb: 58px; }
  .pball[data-pos='right'] { right: 26px; }
  .pball[data-pos='left'] { left: 26px; }
  .pball[data-style='accent'], .pball[data-mode='visitor'][data-style='solid'] { background: var(--accent); color: var(--on-accent); }
  .pball[data-style='glass'] { background: color-mix(in srgb, var(--surface) 55%, transparent); color: var(--ink); backdrop-filter: blur(14px) saturate(1.4); border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
  .pball[data-style='outline'] { background: var(--surface); color: var(--accent); border: 1.5px solid var(--accent); box-shadow: var(--shadow-sm); }
  .pball[data-shape='squircle'] { border-radius: 30%; }
  .pball[data-shape='leaf'] { border-radius: 60% 8px 60% 8px; }
  .pball[data-shape='hexagon'] { border-radius: 0; clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%); }
  .pball[data-shape='hexagon'] .pball-label { display: none; }
  .pball-core { width: var(--pb); height: var(--pb); display: grid; place-items: center; flex: none; }
  .pball-core svg { width: calc(var(--pb) * 0.42); height: calc(var(--pb) * 0.42); transition: transform calc(0.5s * var(--dur)) var(--spring); }
  .pball-label { max-width: 0; white-space: nowrap; font-size: 12px; opacity: 0; overflow: hidden; transition: max-width calc(0.35s * var(--dur)) var(--ease), opacity calc(0.25s * var(--dur)); }
  .pball[data-label='on']:is(:hover, :focus-visible):not([data-shape='hexagon']) { padding-right: 16px; border-radius: 999px; }
  .pball[data-label='on']:is(:hover, :focus-visible) .pball-label { max-width: 180px; opacity: 1; }
  .pball:hover { box-shadow: 0 14px 40px color-mix(in srgb, var(--ink) 22%, transparent); }
  .pball:hover .pball-core svg { transform: rotate(-12deg) scale(1.1); }
  .pball[data-pulse='on']:not([data-shape='hexagon'])::before {
    content: ''; position: absolute; inset: -5px; border-radius: inherit; border: 1.5px solid var(--accent); opacity: 0;
    animation: pball-pulse calc(2.6s * var(--dur)) ease-out infinite; pointer-events: none;
  }
  @keyframes pball-pulse { 0% { transform: scale(0.94); opacity: 0.6; } 100% { transform: scale(1.22); opacity: 0; } }
  @media print { .pball { display: none; } }
  @media (max-width: 600px) { .pball { bottom: 18px; } .pball[data-pos='right'] { right: 16px; } }
</style>

---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { listPublicTags } from '../../server/services/posts';

const tags = listPublicTags();
const max = Math.max(1, ...tags.map((t) => t.count));
---

<PublicLayout title="标签" canonical="/tags">
  <section class="page-head">
    <div class="eyebrow">TAGS</div>
    <h1>标签</h1>
  </section>
  {tags.length === 0 && <p class="muted">还没有标签。</p>}
  <div class="cloud">
    {
      tags.map((t) => (
        <a href={`/tags/${encodeURIComponent(t.tag)}`} style={`font-size:${13 + Math.round((t.count / max) * 9)}px`}>
          {t.tag}
          <small>{t.count}</small>
        </a>
      ))
    }
  </div>
</PublicLayout>

<style>
  .page-head { padding: 40px 0 20px; }
  .page-head h1 { font: 500 34px var(--serif); margin: 8px 0 6px; }
  .cloud { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: baseline; max-width: 820px; }
  .cloud a { color: var(--muted); font-family: var(--serif); }
  .cloud a:hover { color: var(--accent); }
  .cloud small { font: 11px var(--sans); color: var(--faint); margin-left: 3px; }
</style>

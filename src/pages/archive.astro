---
import PublicLayout from '../layouts/PublicLayout.astro';
import { listPublicArchive } from '../server/services/posts';
import { fmtDate, postUrl } from '../lib/format';

const posts = listPublicArchive();
const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const y = (p.publishedAt ?? '').slice(0, 4);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<PublicLayout title="归档" canonical="/archive">
  <section class="page-head">
    <div class="eyebrow">ARCHIVE</div>
    <h1>归档</h1>
    <p class="muted">共 {posts.length} 篇公开文章。</p>
  </section>
  {
    [...byYear].map(([year, list]) => (
      <section class="year">
        <h2>
          {year}
          <small>{list.length} 篇</small>
        </h2>
        <ul role="list">
          {list.map((p) => (
            <li>
              <time datetime={p.publishedAt ?? undefined}>{fmtDate(p.publishedAt).slice(5)}</time>
              <a href={postUrl(p)}>{p.title}</a>
              <span class="where">
                {p.siteName} / {p.categoryName}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</PublicLayout>

<style>
  .page-head { padding: 40px 0 20px; }
  .page-head h1 { font: 500 34px var(--serif); margin: 8px 0 6px; }
  .year { margin-top: 28px; }
  .year h2 { font: 500 22px Georgia, var(--serif); border-bottom: 1px solid var(--line); padding-bottom: 8px; display: flex; gap: 12px; align-items: baseline; }
  .year small { font: 12px var(--sans); color: var(--faint); }
  .year ul { list-style: none; margin: 0; padding: 0; }
  .year li { display: grid; grid-template-columns: 56px 1fr auto; gap: 14px; padding: 9px 0; border-bottom: 1px dashed var(--line); align-items: baseline; }
  .year time { font: 13px Georgia, var(--serif); color: var(--faint); }
  .year a { font-size: 15px; }
  .year a:hover { color: var(--accent); }
  .where { font-size: 12px; color: var(--faint); }
  @media (max-width: 600px) { .year li { grid-template-columns: 48px 1fr; } .where { display: none; } }
</style>

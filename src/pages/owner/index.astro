---
import OwnerLayout from '../../layouts/OwnerLayout.astro';
import { activeModules } from '../../server/services/config';
import { listPosts } from '../../server/services/posts';
import { listBoards, taskCounts } from '../../server/services/tasks';
import { growthSummary, ownerStats } from '../../server/services/stats';
import { activityHeatmap, dayKey } from '../../server/services/activity';
import { listPapers, READ_STATUS } from '../../server/services/knowledge';
import { listTemplates } from '../../server/services/config';
import { relativeTime } from '../../lib/format';
import TaskBoards from '../../components/owner/TaskBoards';

const modules = activeModules('owner-dashboard');
const growth = growthSummary();
const stats = ownerStats().filter((s) => s.enabled);
const counts = taskCounts();
const recent = listPosts({ limit: 6 }).items;
const inProgress = listPosts({ limit: 50 }).items.filter((p) => p.progress && !['已完成', '已精读'].includes(p.progress)).slice(0, 6);
const boards = listBoards({ dashboardOnly: true });
const papers = listPapers().filter((p) => p.readStatus === 'reading' || p.readStatus === 'to-read').slice(0, 6);
const templates = listTemplates();

const heat = activityHeatmap(140);
const cells: { day: string; level: number }[] = [];
const start = new Date();
start.setDate(start.getDate() - 139 - start.getDay());
for (let i = 0; i < 140 + new Date().getDay(); i++) {
  const d = new Date(start);
  d.setDate(start.getDate() + i);
  const k = dayKey(d);
  const n = heat[k] ?? 0;
  cells.push({ day: k, level: n === 0 ? 0 : n < 2 ? 1 : n < 4 ? 2 : n < 7 ? 3 : 4 });
}
const hour = new Date().getHours();
const greet = hour < 6 ? '夜深了' : hour < 12 ? '早上好' : hour < 18 ? '下午好' : '晚上好';
---

<OwnerLayout title="总览" heading={`${greet}，${Astro.locals.owner!.username}`} subtitle="这里的一切只有你能看到。">
  <Fragment slot="actions">
    <a class="btn btn-primary" href="/owner/editor">写新文章</a>
    <button class="btn" type="button" data-checkin>今日已学习 ✓</button>
  </Fragment>

  <div class="dash">
    {
      modules.map((m) => {
        if (m.type === 'quick-write')
          return (
            <section class="panel span-all">
              <div class="panel-head">
                <h2>{m.name}</h2>
              </div>
              <div class="quick">
                {templates.map((t) => (
                  <a class="quick-item" href={`/owner/editor?template=${t.id}`}>
                    <strong>{t.name}</strong>
                    <span>{t.description}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        if (m.type === 'growth')
          return (
            <section class="panel span-all">
              <div class="panel-head">
                <h2>{m.name}</h2>
                <a class="btn btn-sm btn-ghost" href="/owner/display#stats">统计设置</a>
              </div>
              <div class="kpis">
                <div class="kpi"><div class="kpi-label">文章总数</div><div class="kpi-value">{growth.totalPosts}</div><div class="kpi-note">已发布 {growth.published} · 草稿 {growth.drafts}</div></div>
                <div class="kpi"><div class="kpi-label">论文精读笔记</div><div class="kpi-value">{growth.paperNotes}</div><div class="kpi-note">论文库 {growth.papersTotal} · 已读 {growth.papersDeepRead}</div></div>
                <div class="kpi"><div class="kpi-label">完成复现</div><div class="kpi-value">{growth.reproduced}</div></div>
                <div class="kpi"><div class="kpi-label">已完成任务</div><div class="kpi-value">{growth.tasksDone}</div><div class="kpi-note">待办 {counts.open ?? 0}{counts.overdue ? ` · 逾期 ${counts.overdue}` : ''}</div></div>
                {stats.map((s) => (
                  <div class="kpi" title={s.description}>
                    <div class="kpi-label">{s.label}{s.public && <span class="pill pill-accent pub">公开</span>}</div>
                    <div class="kpi-value">{s.value}<small>{s.unit}</small></div>
                  </div>
                ))}
                <div class="kpi"><div class="kpi-label">最长连续学习</div><div class="kpi-value">{growth.learningLongest}<small>天</small></div></div>
              </div>
              <div class="heat-wrap">
                <div class="heat" aria-label="近 20 周学习活动">
                  {cells.map((c) => <span data-l={c.level} title={c.day} />)}
                </div>
                <p class="hint">学习活动：保存文章、完成任务或手动打卡都会计入（仅你可见）。</p>
              </div>
            </section>
          );
        if (m.type === 'recent-edits')
          return (
            <section class="panel">
              <div class="panel-head">
                <h2>{m.name}</h2>
                <a class="btn btn-sm btn-ghost" href="/owner/posts">全部 →</a>
              </div>
              {recent.length === 0 ? <p class="empty-note">还没有文章。</p> : (
                <ul class="list-plain">
                  {recent.map((p) => (
                    <li class="row-between">
                      <a href={`/owner/editor/${p.id}`}>{p.title}</a>
                      <span class="row">
                        {p.hiddenReason ? <span class="pill">{p.hiddenReason}</span> : <span class="pill pill-accent">公开</span>}
                        <span class="faint small">{relativeTime(p.updatedAt)}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        if (m.type === 'in-progress')
          return (
            <section class="panel">
              <div class="panel-head"><h2>{m.name}</h2></div>
              {inProgress.length === 0 ? <p class="empty-note">没有进行中的内容。在编辑器里给文章设置“进度”即可出现在这里。</p> : (
                <ul class="list-plain">
                  {inProgress.map((p) => (
                    <li class="row-between">
                      <a href={`/owner/editor/${p.id}`}>{p.title}</a>
                      <span class="pill pill-warn">{p.progress}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        if (m.type === 'papers')
          return (
            <section class="panel">
              <div class="panel-head">
                <h2>{m.name}</h2>
                <a class="btn btn-sm btn-ghost" href="/owner/papers">论文库 →</a>
              </div>
              {papers.length === 0 ? <p class="empty-note">待读列表是空的。</p> : (
                <ul class="list-plain">
                  {papers.map((p) => (
                    <li class="row-between">
                      <span>{p.title}{p.year && <span class="faint"> · {p.year}</span>}</span>
                      <span class="pill">{READ_STATUS[p.readStatus]}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        if (m.type === 'tasks')
          return (
            <section class="span-all">
              <div class="row-between tasks-head">
                <h2 class="serif">{m.name}</h2>
                <a class="btn btn-sm btn-ghost" href="/owner/tasks">管理任务板 →</a>
              </div>
              <TaskBoards client:load initial={boards} compact />
            </section>
          );
        return null;
      })
    }
  </div>
</OwnerLayout>

<style>
  .dash { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .dash > .panel + .panel { margin-top: 0; }
  .span-all { grid-column: 1 / -1; }
  .quick { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
  .quick-item { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 6px; transition: border-color 0.15s; }
  .quick-item:hover { border-color: var(--accent); }
  .quick-item strong { font: 600 14px var(--serif); }
  .quick-item span { font-size: 11px; color: var(--faint); line-height: 1.6; }
  .pub { margin-left: 6px; font-size: 9px; padding: 0 4px; }
  .heat-wrap { margin-top: 16px; display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; overflow-x: auto; }
  .heat-wrap .hint { margin: 0; max-width: 260px; }
  .small { font-size: 11px; }
  .tasks-head { margin: 12px 0 10px; }
  .tasks-head h2 { font-size: 16px; margin: 0; }
  @media (max-width: 900px) { .dash { grid-template-columns: 1fr; } }
</style>

<script>
  import { api, toast, errMsg } from '../../lib/client';
  document.querySelector('[data-checkin]')?.addEventListener('click', async () => {
    try {
      await api.post('/api/owner/stats');
      toast('已记录今天的学习');
      setTimeout(() => location.reload(), 600);
    } catch (e) {
      toast(errMsg(e), 'error');
    }
  });
</script>

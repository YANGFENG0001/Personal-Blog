---
import OwnerLayout from '../../layouts/OwnerLayout.astro';
import DisplayManager from '../../components/owner/DisplayManager';
import { listModules, listQuotes } from '../../server/services/config';
import { ownerStats } from '../../server/services/stats';
import { getSetting } from '../../server/services/settings';
import { listSites } from '../../server/services/sites';

const props = {
  modules: listModules().filter((m) => m.zone !== 'owner-editor'),
  stats: ownerStats(),
  sites: listSites().map((s) => ({ id: s.id, name: s.name })),
  encourage: getSetting('encourage'),
  quotes: listQuotes(),
};
---

<OwnerLayout title="展示与模块" heading="展示与模块" subtitle="决定游客能看到什么，以及工作台里放什么。">
  <Fragment slot="actions">
    <a class="btn" href="/owner/appearance">外观与主题</a>
    <a class="btn" href="/" target="_blank" rel="noopener">以游客视角查看 ↗</a>
  </Fragment>
  <DisplayManager client:load {...props} />
</OwnerLayout>

<style is:global>
  .mod-zones { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .mod-zone { border: 1px solid var(--line); border-radius: var(--r); padding: 12px 12px 10px; background: var(--bg); }
  .mod-zone h3 { display: flex; align-items: center; gap: 6px; margin: 0 0 8px 4px; }
  .mod-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .mod-item { display: flex; align-items: center; gap: 6px; padding: 5px 8px 5px 4px; border-radius: var(--r-sm); background: var(--surface); border: 1px solid var(--line); transition: opacity 0.2s, border-color 0.2s; }
  .mod-item:hover { border-color: color-mix(in srgb, var(--accent) 30%, var(--line)); }
  .mod-item.is-off { opacity: 0.55; }
  .mod-name { flex: 1; min-width: 0; font-size: 13px; display: flex; }

  .stat-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
  .stat-card { border: 1px solid var(--line); border-radius: var(--r); padding: 16px; display: grid; gap: 14px; align-content: start; background: var(--surface); transition: border-color 0.2s, opacity 0.2s; }
  .stat-card.is-off { opacity: 0.6; }
  .stat-card.is-public { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); box-shadow: inset 3px 0 0 var(--accent); }
  .stat-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .stat-head { min-width: 0; }
  .stat-name { font: 600 15px var(--display); display: flex; }
  .stat-value { font: 500 28px/1 Georgia, var(--serif); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .stat-value small { font: 12px var(--body); color: var(--faint); margin-left: 3px; }
  .stat-def { font-size: 12px; color: var(--faint); line-height: 1.7; margin: 4px 0 0; }
  .stat-label { font-size: 11px; color: var(--faint); margin-bottom: 6px; letter-spacing: 0.06em; }
  .stat-toggles { display: flex; gap: 18px; flex-wrap: wrap; padding-top: 12px; border-top: 1px dashed var(--line); }

  .enc-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; align-items: start; }
  @media (max-width: 900px) { .enc-grid { grid-template-columns: 1fr; } }
  .enc-bars { display: flex; align-items: flex-end; gap: 4px; height: 110px; padding: 8px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg); }
  .enc-bars span { flex: 1; min-height: 3px; border-radius: 3px 3px 0 0; background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent)); transition: height calc(0.4s * var(--dur)) var(--ease); }

  .quote-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
  .quote-card { border: 1px solid var(--line); border-radius: var(--r); padding: 16px 16px 10px; display: flex; flex-direction: column; gap: 6px; background: var(--surface); transition: opacity 0.2s, border-color 0.2s; }
  .quote-card:hover { border-color: color-mix(in srgb, var(--accent) 30%, var(--line)); }
  .quote-card.is-off { opacity: 0.5; }
  .quote-card blockquote { margin: 0; font: 500 15px/1.8 var(--display); }
  .quote-src { font-size: 12px; color: var(--accent); }
  .quote-follow { font-size: 12px; color: var(--muted); line-height: 1.8; margin: 0; }
  .quote-actions { display: flex; align-items: center; gap: 4px; margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--line); }
  .quote-form { margin-bottom: 16px; padding: 16px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg); animation: rise calc(0.25s * var(--dur)) var(--ease); }
</style>

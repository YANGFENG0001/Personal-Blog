---
import OwnerLayout from '../../layouts/OwnerLayout.astro';
import SettingsManager from '../../components/owner/SettingsManager';
import { getAllSettings } from '../../server/services/settings';
import { listProgressOptions, listTemplates } from '../../server/services/config';
import { listUploads } from '../../server/services/uploads';

const s = getAllSettings();
const props = {
  settings: { site: s.site, profile: s.profile },
  templates: listTemplates(),
  progress: listProgressOptions().map((p) => p.label),
  uploads: listUploads(),
  username: Astro.locals.owner!.username,
};
---

<OwnerLayout title="设置" heading="设置" subtitle="站点信息、个人资料、模板、文件与账号。外观与主题在单独的页面。">
  <Fragment slot="actions">
    <a class="btn" href="/owner/appearance">外观与主题</a>
  </Fragment>
  <SettingsManager client:load {...props} />
</OwnerLayout>

<style is:global>
  .st-nav { display: flex; gap: 6px; flex-wrap: wrap; position: sticky; top: 100px; z-index: 5; }
  .st-links li { display: grid; grid-template-columns: 1fr 2fr auto; gap: 6px; padding: 4px 0; border: 0; }
  .st-uploads { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .st-uploads figure { margin: 0; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--pane); transition: border-color 0.2s, box-shadow 0.2s; }
  .st-uploads figure:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); box-shadow: var(--shadow-sm); }
  .st-uploads img { width: 100%; height: 110px; object-fit: cover; display: block; }
  .st-uploads .st-font { height: 110px; display: grid; place-items: center; font: 600 28px var(--display); color: var(--muted); }
  .st-uploads figcaption { padding: 8px; font-size: 11px; display: grid; gap: 4px; }
  .st-uploads code { font-size: 10px; word-break: break-all; color: var(--faint); }
  .st-tpls li { display: flex; align-items: center; gap: 8px; }
  .st-tpl-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st-tpl { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 14px; animation: rise calc(0.25s * var(--dur)) var(--ease); }
  .st-tpl textarea { font-family: var(--mono); font-size: 12px; }
</style>

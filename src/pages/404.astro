---
import PublicLayout from '../layouts/PublicLayout.astro';
Astro.response.status = 404;
---

<PublicLayout title="页面不存在" noindex is404>
  <section class="nf">
    <button class="nf-code" type="button" data-nf-code aria-label="404"><span>4</span><span>0</span><span>4</span></button>
    <h1>这一页不在这里</h1>
    <p class="muted">它可能从未存在，或者暂时没有公开。</p>
    <div class="nf-actions">
      <a class="btn btn-primary" href="/">回到首页</a>
      <a class="btn" href="/search">搜索文章</a>
      <a class="btn" href="/archive">浏览归档</a>
    </div>
  </section>
</PublicLayout>

<style>
  .nf { padding: 90px 0 60px; text-align: center; }
  .nf-code { display: inline-flex; gap: 6px; border: 0; background: none; padding: 0; cursor: default; font: italic 72px/1 Georgia, var(--serif); color: var(--accent); letter-spacing: 0.04em; }
  .nf-code span { display: inline-block; animation: nf-float calc(4s * var(--dur)) ease-in-out infinite; }
  .nf-code span:nth-child(2) { animation-delay: 0.3s; opacity: 0.6; }
  .nf-code span:nth-child(3) { animation-delay: 0.6s; }
  @keyframes nf-float { 50% { transform: translateY(-6px); } }
  .nf h1 { font: 500 26px var(--display); margin: 22px 0 8px; }
  .nf-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
</style>

---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/themes.css';
import '../styles/scenes.css';
import '../styles/scenes-anime.css';
import { getSetting } from '../server/services/settings';
import { resolveAppearance } from '../lib/appearance';
import { sceneHtml, type SceneId } from '../lib/scenes';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  bodyClass?: string;
  /** Decorative page layers (animated background, custom cursor). Off in the workspace. */
  ambient?: boolean;
}

const { title, description, canonical, noindex, ogType = 'website', bodyClass, ambient = true } = Astro.props;
const site = getSetting('site');
const appearance = getSetting('appearance');
// Visitor's own light/dark choice (cookie) overrides the owner's default.
const cookieTheme = Astro.cookies.get('fn_theme')?.value;
const theme = cookieTheme === 'light' || cookieTheme === 'dark' ? cookieTheme : appearance.theme === 'system' ? 'auto' : appearance.theme;
const look = resolveAppearance(appearance, theme);
const attrs = ambient ? look.attrs : { ...look.attrs, 'data-bg': 'none', 'data-cursor': 'system' };
const fullTitle = title === site.title ? title : `${title} · ${site.title}`;
const desc = description || site.intro;
const canonicalUrl = canonical ? new URL(canonical, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang={site.language || 'zh-CN'} {...attrs} style={look.style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={look.preset.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={look.preset.dark.bg} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-bg-effect={ambient && look.bg.effect ? look.bg.effect : undefined}
    data-bg-intensity={look.bg.intensity}
    data-fx={look.preset.fx.join(',')}
    data-trail={ambient && appearance.cursorTrail ? '' : undefined}
  >
    {ambient && <div class="page-bg" aria-hidden="true" />}
    {ambient && look.bg.scene && <Fragment set:html={sceneHtml(look.bg.scene as SceneId)} />}
    <slot />
  </body>
</html>

<script>
  import { initAmbientLayer } from '../lib/ambient-layer';
  initAmbientLayer();
</script>

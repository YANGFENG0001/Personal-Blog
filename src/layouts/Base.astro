---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/themes.css';
import '../styles/scenes.css';
import '../styles/scenes-anime.css';
import { getSetting } from '../server/services/settings';
import { layerStyle, resolveAppearance } from '../lib/appearance';
import { activeAppearance } from '../server/services/active-theme';
import '../styles/custom-theme.css';
import { sceneHtml, type SceneId } from '../lib/scenes';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  bodyClass?: string;
  /** Decorative page layers (animated background, custom cursor). Off in the workspace. */
  ambient?: boolean;
}

const { title, description, canonical, noindex, ogType = 'website', bodyClass, ambient = true } = Astro.props;
const site = getSetting('site');
// The owner can preview any theme (the theme studio's iframe); visitors get the live / rotated theme.
const previewId = Astro.locals.owner ? Astro.url.searchParams.get('theme-preview') : null;
const eggCookie = ambient ? Astro.cookies.get('fn_egg_theme')?.value ?? null : null;
const { appearance, custom, themeId } = activeAppearance(new Date(), previewId, eggCookie);
const eggRules = ambient ? getSetting('themeRotation').eggs : [];
const eggPayload = eggRules.length ? JSON.stringify({ rules: eggRules, active: eggCookie === themeId ? themeId : null }).replace(/</g, '\u003c') : null;
// Visitor's own light/dark choice (cookie) overrides the owner's default.
const cookieTheme = Astro.cookies.get('fn_theme')?.value;
const theme = cookieTheme === 'light' || cookieTheme === 'dark' ? cookieTheme : appearance.theme === 'system' ? 'auto' : appearance.theme;
const look = resolveAppearance(appearance, theme, ambient ? custom : null);
const layers = ambient && custom?.background.use === 'layers' ? custom.background.layers : [];
const customCss = ambient && custom && (custom.css.trim() || custom.typography.displayFont || custom.typography.bodyFont);
const customParticles = ambient && custom?.particles.use === 'image' && custom.particles.images.length
  ? JSON.stringify({ ...custom.particles }).replace(/</g, '\u003c')
  : null;
const attrs = ambient ? look.attrs : { ...look.attrs, 'data-bg': 'none', 'data-cursor': 'system' };
const fullTitle = title === site.title ? title : `${title} · ${site.title}`;
const desc = description || site.intro;
const canonicalUrl = canonical ? new URL(canonical, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang={site.language || 'zh-CN'} {...attrs} style={look.style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={look.preset.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={look.preset.dark.bg} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    {customCss && <link rel="stylesheet" href={`/theme-css/${themeId.slice(7)}.css?v=${encodeURIComponent((custom as { updatedAt?: string }).updatedAt ?? '')}`} />}
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-bg-effect={ambient && look.bg.effect ? look.bg.effect : undefined}
    data-bg-intensity={look.bg.intensity}
    data-fx={look.preset.fx.join(',')}
    data-trail={ambient && appearance.cursorTrail ? '' : undefined}
  >
    {ambient && <div class="page-bg" aria-hidden="true" />}
    {ambient && look.bg.scene && <Fragment set:html={sceneHtml(look.bg.scene as SceneId)} />}
    {
      layers.length > 0 && (
        <div class="theme-layers" aria-hidden="true">
          {layers.map((l) =>
            l.kind === 'scene' && l.scene ? (
              <div class={`theme-layer tl-scene tl-mode-${l.mode}`} style={`--tl-opacity:${l.opacity}`} set:html={sceneHtml(l.scene as SceneId)} />
            ) : (
              <div class={`theme-layer tl-${l.kind} tl-mode-${l.mode} tl-drift-${l.drift}${l.kind === 'texture' ? ` tl-tex-${l.texture ?? 'paper'}` : ''}${l.srcDark ? ' tl-has-dark' : ''}`} style={layerStyle(l)} />
            ),
          )}
        </div>
      )
    }
    {customParticles && <script type="application/json" id="fn-particles" set:html={customParticles} />}
    {eggPayload && <script type="application/json" id="fn-theme-eggs" set:html={eggPayload} />}
    <slot />
  </body>
</html>

<script>
  import { initAmbientLayer } from '../lib/ambient-layer';
  initAmbientLayer();
</script>

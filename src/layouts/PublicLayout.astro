---
import Base from './Base.astro';
import SiteDial from '../components/public/SiteDial.astro';
import AvatarCard from '../components/public/AvatarCard.astro';
import Ambient from '../components/public/Ambient.astro';
import PreviewBall from '../components/PreviewBall.astro';
import Mascot from '../components/public/Mascot.astro';
import { resolveAppearance } from '../lib/appearance';
import { getPack } from '../server/services/mascot-packs';
import { activeAppearance } from '../server/services/active-theme';
import { iconSvg } from '../lib/icons';
import { publicSiteTree, type Site, type Category } from '../server/services/sites';
import { getAllSettings } from '../server/services/settings';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  site?: Site | null;
  category?: Category | null;
  isArticle?: boolean;
  is404?: boolean;
  noindex?: boolean;
}

const { title, description, canonical, ogType, site: current = null, category = null, isArticle = false, is404 = false, noindex } = Astro.props;
const settings = getAllSettings();
const tree = publicSiteTree();
const currentTree = current ? tree.find((s) => s.id === current.id) : null;
const monogram = settings.site.title.slice(0, 1).toUpperCase();
const owner = Astro.locals.owner;
const active = activeAppearance(new Date(), Astro.locals.owner ? Astro.url.searchParams.get('theme-preview') : null, Astro.cookies.get('fn_egg_theme')?.value ?? null);
const look = resolveAppearance(active.appearance, 'auto', active.custom);
const mascot = look.mascot;
// A pack character that was deleted falls back to the built-in default.
const mascotPack = mascot?.character.startsWith('pack:') ? getPack(mascot.character.slice(5)) : null;
if (mascot && mascot.character.startsWith('pack:') && !mascotPack) mascot.character = look.preset.mascot ?? 'haru';
const mascotPage = is404 ? 'notFound' : isArticle ? 'article' : Astro.url.pathname === '/' ? 'home' : 'other';
---

<Base title={title} description={description} canonical={canonical} ogType={ogType} noindex={noindex}>
  <a class="skip-link" href="#main">跳到正文</a>
  {isArticle && <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>}
  <div class="topline" aria-hidden="true"></div>
  <header class="site-header">
    <div class="wrap header-row">
      <div class="brand">
        <!-- A button, not part of the home link, so clicks (and the triple-click egg) don't navigate. -->
        <button class="brandmark" type="button" data-brandmark aria-label={`${settings.site.title} 标识`}>{monogram}</button>
        <a class="brand-text" href="/" aria-label={`${settings.site.title} 首页`}>
          <span class="brand-title">{settings.site.title}</span>
          <span class="brand-sub">{settings.site.subtitle}</span>
        </a>
      </div>
      {current && <div class="header-site" aria-hidden="true">{current.name}<span>{current.enName}</span></div>}
      <div class="header-actions">
        <a class="icon-btn anim-icon" href="/search" aria-label="搜索" title="搜索 (/)" set:html={iconSvg('search')} />
        <button class="icon-btn" type="button" aria-label="切换深浅色" title="切换深浅色" data-theme-toggle>
          <Fragment set:html={iconSvg('sun', 'i-sun')} /><Fragment set:html={iconSvg('moon', 'i-moon')} />
        </button>
        {settings.profile.public && <AvatarCard profile={settings.profile} />}
      </div>
    </div>
    {
      currentTree && currentTree.categories.length > 0 && (
        <nav class="wrap category-bar" aria-label={`${current!.name}栏目`} data-catbar>
          <a href={`/${current!.slug}`} class:list={{ active: !category }} aria-current={!category ? 'page' : undefined}>
            全部
          </a>
          {currentTree.categories.map((c) => (
            <a href={`/${current!.slug}/${c.slug}`} class:list={{ active: category?.id === c.id }} aria-current={category?.id === c.id ? 'page' : undefined}>
              {c.name}
            </a>
          ))}
          <span class="cat-ink" aria-hidden="true" data-cat-ink />
        </nav>
      )
    }
  </header>

  <SiteDial sites={tree} currentSiteId={current?.id} config={settings.dial} monogram={monogram} />

  <main id="main" class="wrap main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <span class="footer-mark" aria-hidden="true">{monogram}</span>
        <div>
          <strong>{settings.site.title}</strong>
          <p>{settings.site.footer}</p>
        </div>
      </div>
      <nav class="footer-col" aria-label="分站">
        <h2>分站</h2>
        {tree.slice(0, 6).map((s) => <a href={`/${s.slug}`}>{s.name}</a>)}
      </nav>
      <nav class="footer-col" aria-label="浏览">
        <h2>浏览</h2>
        <a href="/archive">归档</a>
        <a href="/tags">标签</a>
        <a href="/knowledge">知识库</a>
        <a href="/search">搜索</a>
      </nav>
      <nav class="footer-col" aria-label="订阅">
        <h2>订阅</h2>
        <a href="/rss.xml" class="footer-rss"><Fragment set:html={iconSvg('rss', 'ic')} /> RSS</a>
        <a href="/sitemap.xml">站点地图</a>
      </nav>
    </div>
    <div class="wrap footer-bottom">
      <span>© {new Date().getFullYear()} {settings.site.title}</span>
      <span>{settings.site.subtitle}</span>
    </div>
  </footer>

  {mascot && <Mascot {...mascot} pack={mascotPack} page={mascotPage} />}
  <button class="to-top" type="button" aria-label="回到顶部" title="回到顶部" data-to-top set:html={iconSvg('arrow-up')} />
  <Ambient config={settings.encourage} easter={settings.easter} isArticle={isArticle} is404={is404} />
  {owner && settings.previewBall.enabled && !Astro.url.searchParams.has('theme-preview') && <PreviewBall mode="visitor" config={settings.previewBall} />}
</Base>

<style>
  .topline { height: 2px; background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent)); }
  .read-progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 80; pointer-events: none; }
  .read-progress span { display: block; height: 100%; transform-origin: left; transform: scaleX(0); background: var(--accent); }
  .site-header {
    position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(18px) saturate(1.2); border-bottom: 1px solid var(--line); transition: box-shadow 0.3s;
  }
  :global(body[data-scrolled]) .site-header { box-shadow: 0 6px 24px color-mix(in srgb, var(--ink) 6%, transparent); }
  .header-row { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: 12px; min-width: 0; }
  .brandmark {
    width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: 1px solid var(--accent); color: var(--accent);
    font: italic 20px Georgia, var(--serif); user-select: none; background: transparent; padding: 0; border-radius: var(--r-sm); cursor: pointer;
    transition: transform calc(0.5s * var(--dur)) var(--spring), background 0.2s, color 0.2s;
  }
  .brandmark:hover { transform: rotate(-8deg); }
  .brandmark:active { background: var(--accent); color: var(--on-accent); }
  .brand-text { display: grid; min-width: 0; }
  .brand-title { font-size: 14px; font-weight: 700; letter-spacing: 0.18em; line-height: 1.3; transition: color 0.2s; }
  .brand-text:hover .brand-title { color: var(--accent); }
  .brand-sub { font-size: 11px; color: var(--faint); letter-spacing: 0.06em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .header-site { margin: auto; font: 14px var(--display); color: var(--muted); letter-spacing: 0.12em; display: flex; gap: 10px; align-items: baseline; }
  .header-site span { font: 10px var(--sans); letter-spacing: 0.2em; color: var(--faint); }
  .header-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  [data-theme-toggle] :global(.i-moon) { display: none; }
  [data-theme-toggle] :global(svg) { transition: transform calc(0.5s * var(--dur)) var(--spring); }
  [data-theme-toggle]:hover :global(svg) { transform: rotate(40deg); }
  :global(:root[data-theme='dark']) [data-theme-toggle] :global(.i-sun) { display: none; }
  :global(:root[data-theme='dark']) [data-theme-toggle] :global(.i-moon) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root[data-theme='auto']) [data-theme-toggle] :global(.i-sun) { display: none; }
    :global(:root[data-theme='auto']) [data-theme-toggle] :global(.i-moon) { display: block; }
  }

  .category-bar { position: relative; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; padding: 2px 0 0; view-transition-name: catbar; }
  .category-bar::-webkit-scrollbar { display: none; }
  .category-bar a { position: relative; padding: 9px 14px 12px; font-size: 13px; color: var(--muted); white-space: nowrap; transition: color 0.15s; }
  .category-bar a:first-child { padding-left: 2px; }
  .category-bar a:hover { color: var(--ink); }
  .category-bar a.active { color: var(--accent); font-weight: 650; }
  .cat-ink { position: absolute; bottom: 0; height: 2px; border-radius: 2px; background: var(--accent); transition: left calc(0.35s * var(--dur)) var(--ease), width calc(0.35s * var(--dur)) var(--ease); }

  .main { min-height: 60vh; padding-bottom: 40px; view-transition-name: main; }

  .site-footer { margin-top: 80px; border-top: 1px solid var(--line); padding: 40px 0 28px; font-size: 13px; color: var(--muted); background: color-mix(in srgb, var(--pane) 45%, transparent); }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .footer-brand { display: flex; gap: 14px; align-items: flex-start; }
  .footer-brand strong { display: block; font-size: 13px; letter-spacing: 0.16em; color: var(--ink); }
  .footer-brand p { margin: 6px 0 0; font-size: 12px; color: var(--faint); line-height: 1.8; max-width: 320px; }
  .footer-mark { width: 32px; height: 32px; flex: none; display: grid; place-items: center; border: 1px solid var(--accent); color: var(--accent); font: italic 17px Georgia, var(--serif); border-radius: var(--r-sm); }
  .footer-col { display: grid; gap: 8px; align-content: start; }
  .footer-col h2 { font: 700 10px var(--sans); letter-spacing: 0.2em; color: var(--faint); margin: 0 0 4px; }
  .footer-col a { width: fit-content; position: relative; transition: color 0.15s; }
  .footer-col a:hover { color: var(--accent); }
  .footer-col a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -2px; height: 1px; background: var(--accent); transition: right calc(0.3s * var(--dur)) var(--ease); }
  .footer-col a:hover::after { right: 0; }
  .footer-rss { display: inline-flex !important; align-items: center; gap: 6px; }
  .footer-rss :global(.ic) { width: 14px; height: 14px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 32px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 12px; color: var(--faint); }

  .to-top {
    position: fixed; right: 24px; bottom: 90px; z-index: 50; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--surface); color: var(--muted); display: grid; place-items: center; box-shadow: var(--shadow-sm); cursor: pointer;
    opacity: 0; transform: translateY(12px) scale(0.9); pointer-events: none;
    transition: opacity calc(0.3s * var(--dur)), transform calc(0.35s * var(--dur)) var(--spring), color 0.2s, border-color 0.2s;
  }
  .to-top :global(svg) { width: 17px; height: 17px; }
  .to-top:hover { color: var(--accent); border-color: var(--accent); }
  :global(body[data-scrolled-far]) .to-top { opacity: 1; transform: none; pointer-events: auto; }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .header-site, .brand-sub { display: none; }
    .header-row { gap: 12px; }
    .to-top { right: 16px; bottom: 78px; }
  }
</style>

<script>
  import { initThemeToggle } from '../lib/theme';
  initThemeToggle();
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !e.metaKey && !e.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
      e.preventDefault();
      location.href = '/search';
    }
  });

  // Header shadow, back-to-top and reading progress share one passive scroll listener.
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  let ticking = false;
  const update = () => {
    ticking = false;
    const y = scrollY;
    document.body.toggleAttribute('data-scrolled', y > 8);
    document.body.toggleAttribute('data-scrolled-far', y > innerHeight * 0.8);
    if (bar) {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
    }
  };
  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  update();
  document.querySelector('[data-to-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

  // Category bar: sliding indicator that follows hover and rests on the active item.
  const cat = document.querySelector<HTMLElement>('[data-catbar]');
  const ink = document.querySelector<HTMLElement>('[data-cat-ink]');
  if (cat && ink) {
    const activeLink = cat.querySelector<HTMLElement>('a.active');
    const place = (el: HTMLElement | null) => {
      if (!el) { ink.style.width = '0'; return; }
      const pad = el === cat.firstElementChild ? 2 : 14;
      ink.style.left = `${el.offsetLeft + pad}px`;
      ink.style.width = `${el.offsetWidth - pad - 14}px`;
    };
    ink.style.transition = 'none';
    place(activeLink);
    requestAnimationFrame(() => (ink.style.transition = ''));
    cat.querySelectorAll<HTMLElement>('a').forEach((a) => a.addEventListener('mouseenter', () => place(a)));
    cat.addEventListener('mouseleave', () => place(activeLink));
    activeLink?.scrollIntoView({ block: 'nearest', inline: 'center' });
  }
</script>

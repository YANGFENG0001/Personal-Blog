# ---------- Required in production ----------
# Your domain (DNS A/AAAA record must point at this server). Used by Caddy for HTTPS.
DOMAIN=example.com
# Public URL of the site (canonical links, RSS, sitemap, origin checks).
SITE_URL=https://example.com

# ---------- Optional ----------
# Timezone used for "per day" statistics (streaks, publish days).
TZ=Asia/Shanghai
# Extra allowed origins for owner requests, comma separated (e.g. a second domain).
EXTRA_ORIGINS=
# Token for an external uptime monitor: GET /api/heartbeat?token=...  (leave empty to disable)
HEARTBEAT_TOKEN=
# Set to "false" only when serving over plain HTTP (never in production).
COOKIE_SECURE=true

# ---------- Servers in mainland China (Docker Hub / npm unreachable) ----------
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
# NPM_REGISTRY=https://registry.npmmirror.com

# ---------- Local development only ----------
# DATA_DIR=./data
# PORT=4321

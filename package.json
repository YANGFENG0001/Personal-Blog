{
  "name": "fieldnotes",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "个人博客与 AI 学习研究平台：公开博客 + 站主私人工作台",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --no-warnings scripts/migrate.ts",
    "backup": "node --no-warnings scripts/backup.ts",
    "owner:create": "node --no-warnings scripts/create-owner.ts",
    "theme:check": "node --no-warnings scripts/theme-check.mjs",
    "version:bump": "node --no-warnings scripts/version.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/preact": "^6.0.6",
    "@shikijs/rehype": "^4.5.0",
    "astro": "^7.3.8",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "preact": "^10.29.8",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
